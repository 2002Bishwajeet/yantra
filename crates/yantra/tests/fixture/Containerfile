# Disposable machine for the history redaction test (Y-430): a real Claude Code,
# a real gitleaks, and a stand-in for the Messages API so nothing reaches the
# network once the image is built.
#
# Fedora, like yantrad's fixture, because the host's freshly built `yantra` is
# copied in and run, so this base's glibc must not be older than the host's.

FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install nodejs npm python3 tar gzip curl && dnf clean all

# The release ADR-0032 names, pinned by version and by the sha256 its own
# checksums file publishes.
ARG GITLEAKS=8.30.1
RUN case "$(uname -m)" in \
      x86_64) arch=x64 sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;; \
      aarch64) arch=arm64 sum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;; \
      *) echo "no gitleaks pin for $(uname -m)" >&2; exit 1 ;; \
    esac && \
    curl -fsSLo /tmp/gitleaks.tgz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS}/gitleaks_${GITLEAKS}_linux_${arch}.tar.gz" && \
    echo "$sum  /tmp/gitleaks.tgz" | sha256sum -c - && \
    tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && \
    rm /tmp/gitleaks.tgz

RUN npm install -g @anthropic-ai/claude-code@2.1.290 && npm cache clean --force

COPY messages.py /opt/messages.py

# Claude Code asks for onboarding before `-p` runs unless this is set.
RUN useradd --create-home dev && \
    install -d -o dev -g dev /home/dev/work && \
    printf '{"hasCompletedOnboarding":true}\n' > /home/dev/.claude.json && \
    chown dev:dev /home/dev/.claude.json

CMD ["sleep", "infinity"]
