# Disposable systemd container for the service-unit and installer tests
# (Y-142, Y-158).
#
# The sshd + tmux fixture next door (yantra-core/tests/fixture) exists because
# mocks lie about SSH; this one exists for the same reason one layer out, since
# a unit file is worth only what a real `systemd` says about it. What it cannot
# hold is a real `tailscaled`, so `After=` is read from the unit and never
# watched — that is the boundary Q19 asked about.
#
# Fedora rather than the Alpine next door, which ships no systemd at all. The
# host's freshly built `yantrad` is copied in and run, so this base's glibc must
# not be older than the machine the tests were built on.

FROM registry.fedoraproject.org/fedora:44

# `openssl` and `python3` are the stand-in for github.com that release.sh
# serves; `sudo` and an unprivileged account are how docs/appliance.md says to
# run install.sh, and the branch that fails as root would pass without them.
RUN dnf -y install systemd openssl python3 sudo && dnf clean all

RUN useradd --create-home deploy && \
    printf 'deploy ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/deploy && \
    chmod 440 /etc/sudoers.d/deploy

# `pam_unix` writes an audit record, and a container that cannot reach the
# host's audit subsystem fails sudo with *cannot retrieve authentication info* —
# green here and red on GitHub's runner, which has one. What the fixture asserts
# is that install.sh elevates, never what PAM decides.
RUN printf 'auth sufficient pam_permit.so\naccount sufficient pam_permit.so\nsession sufficient pam_permit.so\n' \
    > /etc/pam.d/sudo

# Y-387: a bare machine for the join command — sshd installed and off, which is
# how most desktop Linux ships it, and tmux and git already here so no test
# fetches a package. `pam_loginuid` cannot write its file in a rootless
# container, and a required one ends every ssh session before it starts.
#
# The account phase is `pam_permit` for the reason sudo's is above: on GitHub's
# runner `pam_unix` cannot read the shadow entry, and sshd refused `deploy` after
# accepting its key — "Access denied … by PAM account configuration" (Y-387).
RUN dnf -y install openssh-server tmux git && dnf clean all && \
    systemctl disable sshd.service && \
    sed -Ei 's/^(session\s+)required(\s+pam_loginuid\.so)/\1optional\2/' /etc/pam.d/sshd && \
    sed -i '1a account    sufficient   pam_permit.so' /etc/pam.d/sshd

# PID 1 here is systemd, which takes SIGRTMIN+3 as "power off" and ignores SIGTERM.
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
