---
import Vine from './motifs/Vine.astro';
import Rosette from './motifs/Rosette.astro';
---

<div class="frame" aria-hidden="true">
  <div class="band band-t"><Vine /></div>
  <div class="band band-b"><Vine /></div>
  <div class="band band-l"><Vine vertical /></div>
  <div class="band band-r"><Vine vertical /></div>
  <div class="rose rose-tl"><Rosette /></div>
  <div class="rose rose-tr"><Rosette /></div>
  <div class="rose rose-bl"><Rosette /></div>
  <div class="rose rose-br"><Rosette /></div>
</div>

<style>
  .frame {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }
  .band {
    position: absolute;
    overflow: hidden;
    background: var(--panel);
  }
  .band :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .band-t { top: 0; left: 0; right: 0; height: var(--border-band); border-bottom: 2px solid var(--ink); }
  .band-b { bottom: 0; left: 0; right: 0; height: var(--border-band); border-top: 2px solid var(--ink); }
  .band-l { top: 0; bottom: 0; left: 0; width: var(--border-band); border-right: 2px solid var(--ink); }
  .band-r { top: 0; bottom: 0; right: 0; width: var(--border-band); border-left: 2px solid var(--ink); }

  /* The rosettes cover the seams where the four bands meet, which is where a chitrakar
     would put one for exactly the same reason. */
  .rose {
    position: absolute;
    width: var(--border-band);
    height: var(--border-band);
    background: var(--panel);
  }
  .rose :global(svg) { display: block; width: 100%; height: 100%; }
  .rose-tl { top: 0; left: 0; }
  .rose-tr { top: 0; right: 0; }
  .rose-bl { bottom: 0; left: 0; }
  .rose-br { bottom: 0; right: 0; }
</style>
