---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const spokes = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * 2 * Math.PI;
  return {
    x1: 20 + Math.cos(a) * 7,
    y1: 20 + Math.sin(a) * 7,
    x2: 20 + Math.cos(a) * 15,
    y2: 20 + Math.sin(a) * 15,
  };
});
---

<svg class={className} viewBox="0 0 40 40" aria-hidden="true">
  <circle cx="20" cy="20" r="15.5" fill="none" stroke="var(--kalam)" stroke-width="1.5" />
  {spokes.map(({ x1, y1, x2, y2 }) => (
    <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="var(--kalam)" stroke-width="1" />
  ))}
  <circle
    cx="20"
    cy="20"
    r="7"
    fill="var(--halo)"
    opacity="var(--halo-alpha)"
    stroke="var(--kalam)"
    stroke-width="1.5"
  />
  <circle cx="20" cy="20" r="3" fill="var(--hingula)" stroke="var(--kalam)" stroke-width="1" />
</svg>
