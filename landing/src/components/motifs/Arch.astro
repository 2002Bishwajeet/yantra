---
import { archPoints, toPath } from './geometry';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const W = 430;
const H = 408;
const SPRING = 300;
const LOBES = 8;

const at = (inset: number) => archPoints({ w: W, h: H, spring: SPRING, lobes: LOBES, inset });

const outer = at(0);
const mid = at(21);
const band = at(11);
const foil = at(29);

// The mid curve springs at x = 27 / 403, not 21 / 409: inset is taken off rx = w/2 - 6, so the
// jambs, the niche fill and this clip must all close on 27/403 or they step at the springing.
const clipD = toPath(mid.map(([x, y]) => [x / W, y / H]), 4) + ` L${403 / W} 1 L${27 / W} 1 Z`;

const pearls: Array<[number, number]> = [];
for (let i = 5; i < band.length - 5; i += 10) pearls.push(band[i]);
for (let y = 308; y < 402; y += 19) pearls.push([16.5, y], [413.5, y]);

// Mirrored index pairs with matched drops; unmatched drops read as a mistake rather than rhythm.
const lamps = ([[96, 56], [156, 32], [244, 32], [304, 56]] as const).map(([i, drop]) => {
  const [x, y] = foil[i];
  return { x, y, b: y + drop };
});
---

<svg class={className} viewBox="0 0 430 408" aria-hidden="true">
  <defs>
    <clipPath id="archClip" clipPathUnits="objectBoundingBox">
      <path d={clipD} />
    </clipPath>
  </defs>

  <path d={toPath(mid) + ' L403 408 L27 408 Z'} fill="var(--halo)" opacity="var(--halo-alpha)" />

  <path
    d={toPath(outer) + ' M6 300 L6 408 M424 300 L424 408'}
    fill="none"
    stroke="var(--kalam)"
    stroke-width="3.5"
    stroke-linejoin="round"
  />

  <path
    d={toPath(mid) + ' M27 300 L27 408 M403 300 L403 408'}
    fill="none"
    stroke="var(--kalam)"
    stroke-width="1.5"
    stroke-linejoin="round"
  />

  {pearls.map(([cx, cy]) => (
    <circle cx={cx} cy={cy} r="3.3" fill="var(--patta-lit)" stroke="var(--kalam)" stroke-width="1.1" />
  ))}

  {lamps.map(({ x, y, b }) => (
    <g>
      <line x1={x} y1={y} x2={x} y2={b} stroke="var(--kalam)" stroke-width="1" />
      <path
        d={`M${x - 2.6} ${b} L${x - 7.5} ${b + 12} Q${x} ${b + 15.5} ${x + 7.5} ${b + 12} L${x + 2.6} ${b} Z`}
        fill="var(--kalam)"
      />
      <circle cx={x} cy={b + 17.5} r="2.4" fill="var(--kalam)" />
    </g>
  ))}
</svg>
