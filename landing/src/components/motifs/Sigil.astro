---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
  <circle
    cx="16"
    cy="16"
    r="14.5"
    fill="var(--halo)"
    opacity="var(--halo-alpha)"
    stroke="var(--kalam)"
    stroke-width="2"
  />
  <path d="M16 6 L25 22 L7 22 Z" fill="none" stroke="var(--kalam)" stroke-width="1.8" stroke-linejoin="round" />
  <path d="M16 26 L7 10 L25 10 Z" fill="none" stroke="var(--hingula)" stroke-width="1.8" stroke-linejoin="round" />
  <circle cx="16" cy="16" r="2.4" fill="var(--kalam)" />
</svg>
