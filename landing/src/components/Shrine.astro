---
import Arch from './motifs/Arch.astro';
import YantraShader from './YantraShader';
---

{/* The niche and its canvas are styled from global.css, not from a scoped block here:
    Astro's scoping stamps its class only on elements in this template, so it never reaches
    the DOM a client:only island creates, and the canvas would stay at its 300x150 default. */}
<div class="shrine">
  <div class="niche">
    <YantraShader client:only="react" />
  </div>
  <Arch class="arch" />
  <div class="utter">
    <h1 class="deva">यन्त्र</h1>
    <p class="latin">Yantra</p>
  </div>
</div>
