---
// A review surface for the drawing stacks, not part of the site proper. It exists so the
// frame can be looked at on a deploy preview rather than only on a machine that can run the
// dev server. `src/pages/index.astro` is still the landing page.
import '@fontsource/eczar/400.css';
import '@fontsource/eczar/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../../patta/tokens.css';
import '../../patta/ground.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Yantra — patta frame preview</title>
  <meta name="robots" content="noindex" />
</head>
<body>
  <div class="band-ground patta-band"></div>
  <div class="cloth-ground patta-cloth"></div>
  <svg id="frame" aria-hidden="true"></svg>

  <div class="inner">
    <div>
      <div class="lockup">
        <span class="deva">यन्त्र</span><span class="latin">yantra</span>
      </div>
      <div class="soon">coming soon</div>
    </div>
  </div>

  <div class="ctl">
    <label for="dens">density</label>
    <input id="dens" type="range" min="40" max="140" value="65" step="5" />
    <span id="densv">65%</span>
  </div>
</body>
</html>

<style is:global>
  :root {
    --font-display: 'Eczar', serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    /* --band-base is the 100%-density width; the script derives --band-w from it. vmin so a
       short landscape window never gets a band taller than its own content area. */
    --band-base: clamp(22px, 3.7vmin, 50px);
    --band-w: var(--band-base);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    font-family: var(--font-display);
    color: var(--ink);
    overflow: hidden;
  }

  .band-ground  { position: fixed; inset: 0; z-index: 0; }
  .cloth-ground { position: fixed; inset: var(--band-w); z-index: 0; }
  #frame        { position: fixed; inset: 0; z-index: 1; pointer-events: none; display: block; }

  .inner {
    position: fixed; inset: var(--band-w); z-index: 2;
    display: grid; place-items: center;
    padding: clamp(16px, 4vmin, 54px);
    text-align: center;
  }
  .lockup { display: flex; align-items: baseline; gap: .5em; justify-content: center; flex-wrap: wrap; }
  .deva   { font-size: clamp(34px, 8vmin, 96px); font-weight: 600; line-height: 1; }
  .latin  { font-family: var(--font-mono); font-size: clamp(9px, 1.5vmin, 15px);
            text-transform: uppercase; letter-spacing: .42em; opacity: .72; }
  .soon   { font-family: var(--font-mono); font-size: clamp(8px, 1.3vmin, 12px);
            text-transform: uppercase; letter-spacing: .34em; color: var(--lac); margin-top: 1.4em; }

  .ctl {
    position: fixed; z-index: 9; bottom: 8px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 6px; align-items: center;
    font-family: var(--font-mono); font-size: 11px;
    background: #0009; color: #fff; padding: 6px 10px;
  }
  .ctl label { opacity: .7; letter-spacing: .1em; }
</style>

<script>
  import { borderFrame } from '../../patta/border';

  const svg = document.getElementById('frame') as unknown as SVGSVGElement;
  const dens = document.getElementById('dens') as HTMLInputElement;
  const densv = document.getElementById('densv')!;

  // Drawn in CSS pixels at viewport size and redrawn on resize, rather than scaled from a
  // fixed viewBox — scaling would stretch the florets on any non-matching aspect ratio.
  function draw() {
    const w = Math.round(window.innerWidth);
    const h = Math.round(window.innerHeight);

    // Density scales band and tile together: the cell must stay square, because the tile
    // symbols carry preserveAspectRatio="none" and any other ratio stretches every floret.
    const d = Number(dens.value) / 100;
    const base = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--band-base')
    ) || 40;
    const band = Math.round(base / d);
    document.documentElement.style.setProperty('--band-w', band + 'px');

    svg.setAttribute('width', String(w));
    svg.setAttribute('height', String(h));
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    svg.innerHTML = borderFrame({ w, h, band, tile: band });
  }

  draw();
  addEventListener('resize', draw, { passive: true });
  dens.addEventListener('input', () => { densv.textContent = dens.value + '%'; draw(); });
</script>
