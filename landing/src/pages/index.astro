---
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/2002Bishwajeet/yantra';
---

<Layout
  title="Yantra — coming soon"
  description="One control plane for every machine you already own."
>
  <div class="band-ground patta-band" aria-hidden="true"></div>
  <div class="cloth-ground patta-cloth" aria-hidden="true"></div>
  <svg id="frame" aria-hidden="true"></svg>

  <div class="field">
    <div class="panel" id="panel">
      <svg id="gate" aria-hidden="true"></svg>
      {/* Two lines rather than one: the single-line form is 50 characters of tracked mono and
          it ran off both sides of a phone-width opening. */}
      <p class="reading" id="reading">
        <span>Jai Prakash Yantra</span><span id="reading-sun"></span>
      </p>

      <main class="opening" id="opening">
        <h1 class="lockup">
          <span class="deva">यन्त्र</span><span class="latin">yantra</span>
        </h1>
        <p class="say">One control plane for every machine you already own.</p>
        <p class="soon">
          Coming soon<span class="sep" aria-hidden="true">·</span><a href={repo}>github</a>
        </p>
      </main>
    </div>
  </div>
</Layout>

<style>
  /* Cream under the border band, cloth inside it — two grounds, edge to edge, so the frame
     sits on its own surface the way the painted border does on the reference. */
  .band-ground { position: fixed; inset: 0; z-index: 0; }
  .cloth-ground { position: fixed; inset: var(--band-w); z-index: 0; }

  /* Above the field so the corner florets close over the arch's creeper rather than under it. */
  #frame { position: fixed; inset: 0; z-index: 3; pointer-events: none; display: block; }

  .field { position: fixed; inset: var(--band-w); z-index: 1; }
  /* position and size come from the script: the arch gets its own panel inside the field. */
  .panel { position: absolute; }
  #gate { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* Placed by the script from the arch's own opening, so the words sit below the springing
     where the opening is a plain rectangle and nothing can foul the cusps. */
  .opening {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(.5rem, 1.6vmin, 1.1rem);
    /* keeps the longest line off the jambs on a narrow opening */
    padding-inline: clamp(4px, 3%, 18px);
    text-align: center;
  }

  .lockup {
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: .55em;
    flex-wrap: wrap;
    font-weight: 400;
  }
  .deva { font-size: clamp(30px, 7vmin, 84px); font-weight: 600; line-height: 1; }
  .latin {
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.35vmin, 14px);
    text-transform: uppercase;
    letter-spacing: .42em;
    text-indent: .42em;
    opacity: .74;
  }

  .say {
    margin: 0;
    max-width: 32ch;
    font-size: clamp(13px, 1.9vmin, 20px);
    line-height: 1.45;
    text-wrap: balance;
  }

  .soon {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .9em;
    font-family: var(--font-mono);
    font-size: clamp(8px, 1.25vmin, 12px);
    text-transform: uppercase;
    letter-spacing: .3em;
    text-indent: .3em;
  }
  .sep { color: var(--accent); }
  .soon a {
    color: inherit;
    text-decoration: none;
    border-bottom: var(--line-hair) solid var(--ink-dim);
    padding-bottom: .3em;
  }
  .soon a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* The instrument's caption. Centred under the bowl by the script; translate does the
     centring so the script only has to know where the bowl's bottom is. */
  .reading {
    position: absolute;
    margin: 0;
    transform: translate(-50%, 0);
    text-align: center;
    line-height: 1.8;
    font-family: var(--font-mono);
    font-size: clamp(7px, 1.05vmin, 11px);
    text-transform: uppercase;
    /* .16em, not the .2em the other mono labels carry: this line is the longest on the page
       and the tracking is what pushed it into the jambs at phone width. */
    letter-spacing: .16em;
    text-indent: .16em;
    color: var(--ink-dim);
  }
  .reading span { display: block; white-space: nowrap; }
</style>

<script>
  import { borderFrame } from '../patta/border';
  import { torana, toranaOpening } from '../patta/torana';
  import type { ToranaOpts } from '../patta/torana';
  import { jaiPrakash, sunPosition } from '../patta/instrument';

  /* Settled at the frame review: denser and the florets lose the cream ground they are cut
     out of, looser and the band reads as a rule rather than a course of flowers. */
  const DENSITY = 0.65;

  /* The Jai Prakash that actually exists, at the Jantar Mantar in Jaipur. The bead is read
     against the viewer's clock over *that* site rather than over the viewer: locating them
     would need a permission prompt, and the instrument is a real one standing in a real place. */
  const SITE = { lat: 26.9247, lon: 75.8206 };

  const root = document.documentElement;
  const frame = document.getElementById('frame')!;
  const panel = document.getElementById('panel')!;
  const gate = document.getElementById('gate')!;
  const opening = document.getElementById('opening')!;
  const reading = document.getElementById('reading')!;
  const sun = document.getElementById('reading-sun')!;

  const px = (v: number) => Math.round(v) + 'px';

  function readout(now: Date) {
    const s = sunPosition(now, SITE.lat, SITE.lon);
    return s.up
      ? `Jaipur · sun ${Math.round(s.alt)}° above the horizon`
      : 'Jaipur · sun below the horizon';
  }

  function draw() {
    const vw = Math.round(window.innerWidth);
    const vh = Math.round(window.innerHeight);
    const now = new Date();

    /* Density scales the band and the tile together. The tile symbols carry
       preserveAspectRatio="none", so a cell that is not square stretches every floret into a
       pair of horizontal almonds. */
    const base =
      parseFloat(getComputedStyle(root).getPropertyValue('--band-base')) || 40;
    const band = Math.round(base / DENSITY);
    root.style.setProperty('--band-w', px(band));

    /* Drawn in CSS pixels at viewport size and redrawn on resize rather than scaled from a
       fixed viewBox, because scaling stretches the florets on any aspect ratio that does not
       match the one the box was authored at. */
    frame.setAttribute('width', String(vw));
    frame.setAttribute('height', String(vh));
    frame.setAttribute('viewBox', `0 0 ${vw} ${vh}`);
    frame.innerHTML = borderFrame({ w: vw, h: vh, band, tile: band });

    const w = vw - 2 * band;
    const h = vh - 2 * band;

    /* The arch does not take the field's shape — it has one of its own. A near-square panel
       puts the head's two radii within a few percent of each other, which is the round torana
       of the reference; spanning a 1.7:1 desktop field flattens it into a tent, and spanning a
       phone field draws a 3:1 lancet. So the panel is squared up where the field is wide and
       allowed to run to 1.7 tall where it is narrow, and the slack stays open cloth. */
    const pw = Math.min(w, h * 1.05);
    const ph = Math.min(h, pw * 1.7);
    panel.style.left = px((w - pw) / 2);
    panel.style.width = px(pw);
    // 0.58, not half: the slack goes above the crown, because a gate whose feet sit near the
    // lower border is standing on something and one centred in the field is hanging in it
    panel.style.top = px((h - ph) * 0.58);
    panel.style.height = px(ph);

    /* The band's measured width is a fraction of the panel, and on a phone that fraction is 8px
       — at which the pearls are 4px and the creeper's leaves are a fuzz. The floor is a
       legibility guard, not a second opinion about the reference. */
    const opts: ToranaOpts = {
      w: pw,
      h: ph,
      spring: ph * 0.42,
      bandW: Math.max(10, Math.min(pw * 0.026, ph * 0.05)),
    };
    const open = toranaOpening(opts);
    const headH = open.baseY - open.headTop;
    const openW = open.x1 - open.x0;
    const gap = Math.max(10, headH * 0.05);

    /* The bowl hangs across the springing, as the reference figure does — one that clears the
       line is small enough to look mislaid in the middle of the arch. Its radius is fitted
       against the opening's actual boundary: the two upper cusps bind well before the
       half-width does, and sizing off the half-width drew the bowl straight over the band. */
    const cy = open.headTop + (open.footY - open.headTop) * 0.4;
    let clear = Math.min(openW / 2, open.footY - cy);
    for (const [x, y] of open.edge) clear = Math.min(clear, Math.hypot(x - open.cx, y - cy));
    const r = clear * 0.93;

    /* The instrument goes down first and the arch over it. The lamps hang from the inner cusps,
       inside the opening the bowl is fitted to, so they cross it whatever the radius — in front
       of the bowl they are lamps hanging before it, behind it they are clipped stubs. */
    gate.setAttribute('viewBox', `0 0 ${pw} ${ph}`);
    gate.innerHTML =
      `<g transform="translate(${open.cx.toFixed(1)} ${cy.toFixed(1)})">` +
      jaiPrakash({ r, now, lat: SITE.lat, lon: SITE.lon }) +
      '</g>' +
      torana(opts);

    sun.textContent = readout(now);
    reading.style.left = px(open.cx);
    reading.style.top = px(cy + r + gap * 0.6);

    // measured, not assumed: the caption's height is whatever the mono face gives it here
    const top = cy + r + gap * 0.6 + reading.offsetHeight + gap;
    opening.style.left = px(open.x0);
    opening.style.width = px(openW);
    opening.style.top = px(top);
    opening.style.height = px(Math.max(0, open.footY - gap - top));
  }

  draw();
  addEventListener('resize', draw, { passive: true });
</script>
