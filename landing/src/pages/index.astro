---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import painting from '../assets/vishvakarma.png';
import mark from '../assets/yantra-mark.png';
/* Read at build time from the workspace manifest rather than typed here. Three places on this
   page name the release, and `Cargo.toml` is the one file a version bump already touches — see
   Y-364, where changing that single line moved all four crates. `?raw` rather than `readFileSync`:
   the bundler rewrites `import.meta.url` in the prerender chunk, so a path relative to this file
   stops being relative to this file. */
import manifest from '../../../Cargo.toml?raw';

const version = manifest.match(/^version = "([^"]+)"$/m)?.[1];
if (!version) throw new Error('no [workspace.package] version in Cargo.toml');

/* The painting is the page, so it is worth the pipeline: 3 MB of PNG would be the whole page
   weight. Quality 68 rather than the default: at 1:1 on the busiest part of the painting it is
   indistinguishable from 82 and a third smaller, and the vignette and the cloth's own shading sit
   over most of it anyway. */
const ground = await getImage({ src: painting, format: 'webp', width: 1585, quality: 68 });
const sigil = await getImage({ src: mark, format: 'webp', width: 88 });

const repo = 'https://github.com/2002Bishwajeet/yantra';
const release = `${repo}/releases/tag/v${version}`;
const install = 'cargo install --path crates/yantra';
---

<Layout
  title="Yantra — one workspace, one interface, every machine"
  description="Name the work, not the machine. Yantra conducts ssh, tmux and your agent across your own machines, over Tailscale."
>
  <div class="runway">
    <div class="frame" data-frame data-beat="0">
      <img class="ground" src={ground.src} alt="" fetchpriority="high" decoding="async" />
      <canvas class="cloth" data-fx="cloth" aria-hidden="true"></canvas>
      <div class="vignette" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>

      <div class="content">
        <header class="masthead">
          <a class="wordmark" href={repo}>
            <img src={sigil.src} alt="" width="44" height="44" decoding="async" />
            <span class="wordmark__latin">Yantra</span>
            <span class="wordmark__deva" lang="sa">यन्त्र</span>
          </a>
          <nav class="actions">
            <span class="tag">v{version}</span>
            <a class="pill" href={repo} aria-label="Star on GitHub">
              <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true"
                ><path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-2.92-.88-2.92-2.85 0-.58.21-1.07.55-1.45-.05-.13-.24-.66.05-1.37 0 0 .54-.17 1.77.66.51-.14 1.05-.21 1.6-.21.55 0 1.09.07 1.6.21 1.23-.84 1.77-.66 1.77-.66.29.71.1 1.24.05 1.37.34.38.55.86.55 1.45 0 1.98-1.15 2.65-2.93 2.85.31.27.58.79.58 1.6 0 1.15-.01 2.06-.01 2.35 0 .21.15.46.55.38A7.99 7.99 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                ></path></svg
              >
              <span class="pill__label">Star on GitHub</span>
            </a>
            <a class="pill pill--accent" href={release}>
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" class="stroke"
                ><path d="M12 4v11"></path><path d="m7 11 5 5 5-5"></path><path d="M5 20h14"
                ></path></svg
              >
              Download v{version}
            </a>
          </nav>
        </header>

        <main class="middle">
          <section class="panel">
            <div class="panel__inlay" aria-hidden="true"></div>
            <div class="panel__body">
              <p class="eyebrow">
                <span class="eyebrow__rule" aria-hidden="true"></span>
                <span><span class="deva" lang="sa">यन्त्र</span> · Machine, instrument, apparatus</span>
              </p>

              <h1 class="claim">
                <span data-clause="0">One workspace.</span>
                <span data-clause="1">One interface.</span>
                <span data-clause="2">Every machine.</span>
              </h1>

              <div class="verses">
                <p data-verse="0">
                  You name the work, not the machine.<br />Somewhere a laptop still holds your
                  morning.
                </p>
                <p data-verse="1">
                  The instrument remembers where it lives.<br />It chooses the machine, and reaches
                  it.
                </p>
                <p data-verse="2">
                  The session is still open. The agent goes on.<br />You were only away.
                </p>
              </div>

              <div class="doing">
                <span class="session">
                  <span class="session__dot" aria-hidden="true"></span>
                  <span class="session__name">landing</span>
                  <span class="session__where">running · macbook</span>
                  <span class="session__age">39m</span>
                </span>
                <button class="copy" type="button" data-copy data-command={install}>
                  <span class="copy__sigil" aria-hidden="true">$</span>
                  <span class="copy__command">{install}</span>
                  <span class="copy__tag" data-copy-tag>Copy</span>
                </button>
              </div>
            </div>
          </section>
        </main>

        <footer class="colophon">
          <span class="creed">
            <img src={sigil.src} alt="" width="20" height="20" decoding="async" />
            Local-first, over Tailscale. SSH, tmux and your agent, conducted.
          </span>
          <span class="progress">
            <span class="pip" data-pip="0"></span>
            <span class="pip" data-pip="1"></span>
            <span class="pip" data-pip="2"></span>
            <span class="hint" data-hint>Scroll</span>
          </span>
        </footer>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { createCloth } from '../lib/canvas-fx.js';

  const frame = document.querySelector<HTMLElement>('[data-frame]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-fx="cloth"]');
  const ground = document.querySelector<HTMLImageElement>('.ground');
  let beat = 0;

  /* The cloth samples the painting rather than the DOM, so it needs the decoded bitmap and not
     the element. The <img> below it stays visible either way: it is what a machine with no WebGL2
     sees, and the fabric composites over it when there is one. */
  const cloth =
    canvas && ground
      ? await ground
          .decode()
          .then(() =>
            createCloth(
              canvas,
              (ctx: CanvasRenderingContext2D, w: number, h: number) => {
                const scale = Math.max(w / ground.naturalWidth, h / ground.naturalHeight);
                const dw = ground.naturalWidth * scale;
                const dh = ground.naturalHeight * scale;
                ctx.drawImage(ground, (w - dw) / 2, (h - dh) / 2, dw, dh);
              },
              {
                pin: 'top', wind: 1.5, speed: 0.42, amplitude: 16, drape: 22,
                brush: 2, brushSize: 180, damping: 1.1, light: 0.6, sheen: 0.16,
                shadow: 0, cornerRadius: 0, backing: [0.043, 0.031, 0.024], perspective: 1500,
              },
            ),
          )
          .catch(() => null)
      : null;

  /* Say when the fabric exists. `decode()` above is async and the cloth renders on the frame after
     it is created, so a screenshot taken two frames after load catches the backing colour and not
     the painting — which is what the visual regression did until it was told to wait. One frame is
     enough: the cloth queued its own callback first, and rAF runs them in order. */
  requestAnimationFrame(() => {
    frame?.setAttribute('data-cloth', cloth ? 'on' : 'off');
  });

  /* One piece of state. Everything the beat changes is a CSS rule keyed off `[data-beat]`, so the
     reduced-motion and no-script fallbacks are stylesheet edits rather than branches in here. */
  function tick() {
    const span = Math.max(document.documentElement.scrollHeight - innerHeight, 1);
    const p = Math.min(Math.max(scrollY / span, 0), 1);
    frame!.toggleAttribute('data-scrolled', p > 0.03);
    const next = p < 0.34 ? 0 : p < 0.7 ? 1 : 2;
    if (next === beat) return;
    beat = next;
    frame!.dataset.beat = String(beat);
    /* Each beat raises the wind and deepens the folds. */
    cloth?.setOptions({ wind: 1.5 + beat * 0.7, amplitude: 16 + beat * 7 });
  }

  if (frame) {
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
    tick();
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const tag = document.querySelector<HTMLElement>('[data-copy-tag]');
  let restore = 0;
  copy?.addEventListener('click', async () => {
    if (!tag) return;
    try {
      await navigator.clipboard.writeText(copy.dataset.command ?? '');
      tag.textContent = 'Copied';
    } catch {
      tag.textContent = 'Select it';
    }
    clearTimeout(restore);
    restore = window.setTimeout(() => {
      tag.textContent = 'Copy';
    }, 1600);
  });
</script>
