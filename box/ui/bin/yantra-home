#!/bin/bash
export ZELLIJ_CONFIG_DIR=${YANTRA_BOX_SHARE:-/usr/local/share/yantra-box}/zellij
# A restored session holds every command until a key press, so a reboot starts a new one.
zellij list-sessions -n 2>/dev/null | grep -q '^yantra .*EXITED' && zellij delete-session yantra
if zellij list-sessions -ns 2>/dev/null | grep -qx yantra; then
    zellij attach yantra
else
    zellij -s yantra
fi
