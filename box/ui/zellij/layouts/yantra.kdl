layout {
    default_tab_template {
        children
        pane size=1 borderless=true { plugin location="zellij:compact-bar"; }
    }
    tab name="Home" focus=true {
        pane split_direction="vertical" {
            pane size=30 command="yantra-menu" focus=true
            pane command="wtfutil" { args "--config" "/usr/local/share/yantra-box/wtf/config.yml"; }
        }
    }
    tab name="System" {
        pane command="bash" {
            args "-c" "while :; do btop; done"
        }
    }
    tab name="Services" {
        pane command="bash" {
            args "-c" "while :; do systemctl-tui; done"
        }
    }
}
